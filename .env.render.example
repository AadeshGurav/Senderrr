# .env.render.example — All Render-specific environment variables for Senderrr
#
# Copy to .env for local development (not used on Render — use dashboard or render.yaml):
#   cp .env.render.example .env
#
# On Render, set these via:
#   Dashboard → Service → Environment → Add Environment Variable
#   or via render.yaml with `sync: false` for secrets
#
# ================================================================
# RENDER PLATFORM VARIABLES (set automatically, do not override)
# ================================================================

# Set by Render when a persistent disk is attached.
# All persistent data (sessions, SQLite, media) is stored here.
# Format: /var/data or similar path depending on Render's disk mount.
# RENDER_DISK_PATH=/var/data

# Set by Render to 'true' when running on the Render platform.
# Used to detect Render environment for platform-specific behavior.
# RENDER=true

# Set by Render's HTTPS proxy. Use to enforce HTTPS redirects.
# X-Forwarded-Proto: https

# ================================================================
# CORE APPLICATION (required)
# ================================================================

# Node environment
NODE_ENV=production

# HTTP port — Render sets PORT=10000 automatically
PORT=10000

# Bind address — must be 0.0.0.0 for Render
HOST=0.0.0.0

# ================================================================
# SECURITY — SECRETS (sync: false, do not commit to repo)
# ================================================================

# JWT secret for WA Automation operator authentication
# Generate with: node -e "console.log(require('crypto').randomUUID())"
WA_JWT_SECRET=CHANGE_ME

# Admin API key — master key for the entire API
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=CHANGE_ME

# CORS allowed origins (comma-separated URLs)
# Empty = same-origin only (most secure)
# Example: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=

# Comma-separated IPs/CIDRs of trusted reverse proxies
# On Render, the platform proxy provides valid X-Forwarded-For
TRUSTED_PROXIES=0.0.0.0/0

# Enforce HTTPS redirect when behind Render's HTTPS proxy
ENFORCE_HTTPS=true

# CSP report-only mode (violations logged, not blocked)
# Set to 'true' during initial deployment, then 'false' once CSP is tuned
CSP_REPORT_ONLY=false

# ================================================================
# FREE TIER OPTIMIZATION
# ================================================================

# Disable Redis on free tier (no external service = zero cost)
REDIS_ENABLED=false

# Disable BullMQ queue — webhooks delivered synchronously
QUEUE_ENABLED=false

# Enable keep-alive ping to prevent free tier spin-down
KEEP_ALIVE_ENABLED=true

# Keep-alive interval in milliseconds (7 min < 15 min spin-down threshold)
KEEP_ALIVE_INTERVAL_MS=420000

# ================================================================
# DATABASE (SQLite on persistent disk — zero cost)
# ================================================================

DATABASE_TYPE=sqlite
DATABASE_NAME=/var/data/openwa.sqlite
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# For PostgreSQL (paid Render Postgres, not on free tier):
# DATABASE_TYPE=postgres
# DATABASE_HOST=your-postgres.internal
# DATABASE_PORT=5432
# DATABASE_USERNAME=your_user
# DATABASE_PASSWORD=your_password
# DATABASE_SYNCHRONIZE=false
# DATABASE_SSL=true

# ================================================================
# STORAGE (local filesystem on persistent disk)
# ================================================================

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/var/data/media

# For S3 storage (not needed on free tier):
# STORAGE_TYPE=s3
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_key
# S3_SECRET_ACCESS_KEY=your_secret
# S3_ENDPOINT=https://s3.amazonaws.com

# ================================================================
# WHATSAPP SESSION PERSISTENCE (critical — must be on persistent disk)
# ================================================================

# WhatsApp session state (Chrome profiles, auth tokens)
# MUST be on persistent disk to survive restarts and re-scans
SESSION_DATA_PATH=/var/data/sessions

# Puppeteer args for containerized environment
# --no-sandbox: required in containerized environments
# --disable-setuid-sandbox: required for Chromium in non-root containers
# --disable-dev-shm-usage: required on Render (limited /dev/shm)
# --disable-gpu: no GPU available in containers
# --no-first-run: skip Chrome first-run experience
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu,--disable-software-rasterizer,--no-first-run
PUPPETEER_HEADLESS=true

# ================================================================
# RATE LIMITING (hardened for public internet)
# ================================================================

# Short burst protection: 10 requests per second
RATE_LIMIT_SHORT_TTL=1000
RATE_LIMIT_SHORT_LIMIT=10

# Medium protection: 100 requests per minute
RATE_LIMIT_MEDIUM_TTL=60000
RATE_LIMIT_MEDIUM_LIMIT=100

# Long protection: 500 requests per hour (tightened for public API)
RATE_LIMIT_LONG_TTL=3600000
RATE_LIMIT_LONG_LIMIT=500

# ================================================================
# WEBHOOK CONFIGURATION (sync delivery on free tier)
# ================================================================

WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=5000

# ================================================================
# LOGGING
# ================================================================

LOG_LEVEL=info

# ================================================================
# AUTOMATION (optional — scraper/scheduler)
# ================================================================

# Active hours (UTC) — adjust for your timezone
# SCRAPER_ACTIVE_HOUR_START=0
# SCRAPER_ACTIVE_HOUR_END=23
# SCRAPER_ACTIVE_WEEKDAYS=0,1,2,3,4,5,6

# Message rate limits (adjust for WhatsApp account safety)
# AUTOMATION_HOURLY_LIMIT=500
# AUTOMATION_DAILY_LIMIT=5000
# AUTOMATION_BATCH_SIZE=50
# AUTOMATION_BATCH_COOLDOWN=900
# AUTOMATION_JITTER_MIN=30
# AUTOMATION_JITTER_MAX=120