# ===================================================================
# WhatsApp Automation — Configuration
# ===================================================================
# Copy this file to .env and fill in YOUR values:
#
#   cp .env.example .env
#
# Only SCRAPER_TARGET_URL is required. Everything else has safe defaults.
# ===================================================================

# ---------------------------------------------------------------------------
# REQUIRED — The URL to monitor for new articles
# ---------------------------------------------------------------------------
SCRAPER_TARGET_URL=https://example.com/articles

# ---------------------------------------------------------------------------
# OPTIONAL — Override only if you know what you're doing
# ---------------------------------------------------------------------------

# Django
# DJANGO_SECRET_KEY=change-me-to-a-random-string-in-production
# DJANGO_DEBUG=True

# Redis (used by Celery task queue)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Scraper tuning
# SCRAPER_REQUEST_TIMEOUT=30
# SCRAPER_MAX_RETRIES=3

# Playwright browser
# PLAYWRIGHT_USER_DATA_DIR=.playwright_session
# PLAYWRIGHT_HEADLESS=False

# Anti-ban delays (seconds) — DO NOT reduce these
# AUTOMATION_JITTER_MIN=30
# AUTOMATION_JITTER_MAX=120
# AUTOMATION_TYPING_DELAY_MIN=0.03
# AUTOMATION_TYPING_DELAY_MAX=0.12
